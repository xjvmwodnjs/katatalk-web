# KataTalk local development
# Copy this file to .env and change the values as needed.

# Production: required. Local dev: if omitted, the server uses a fixed insecure
# fallback and logs a warning — copy this file to .env and set a real secret
# when testing auth/cookies seriously.
JWT_SECRET=replace-with-a-long-random-local-secret

# 인증 제공자 (서버 AUTH_PROVIDER / 클라이언트 VITE_AUTH_PROVIDER 를 맞출 것)
# local-dev: 고정 모의 사용자 (쿠키 없이 항상 로그인된 것처럼 동작, 로컬 전용)
# legacy-manus: 구 Manus OAuth (참고용)
# supabase: Supabase Auth + Bearer JWT (상용 로그인 경로)
AUTH_PROVIDER=local-dev
VITE_AUTH_PROVIDER=local-dev

# --- Supabase (AUTH_PROVIDER=supabase 일 때 필수에 가깝게 설정) ---
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# SUPABASE_URL=          # 서버용. 보통 VITE_SUPABASE_URL 과 동일
# SUPABASE_ANON_KEY=     # 서버 JWT 검증용 anon 키 (service_role 넣지 말 것)
#
# SUPABASE_SERVICE_ROLE_KEY 는 이번 단계에서 사용하지 않음.
# 추후 서버 관리 작업에만 쓰고, 프론트·README·로그에 절대 노출하지 말 것.

# Optional local mock user shown by auth.me when AUTH_PROVIDER=local-dev.
LOCAL_DEV_USER_EMAIL=dev@katatalk.local
LOCAL_DEV_USER_NAME=Local Developer

# Optional database. If omitted, the app still runs, but protected DB-backed
# profile and history data fall back to demo defaults.
# DATABASE_URL=mysql://user:password@localhost:3306/katatalk

# Optional server port.
PORT=3000

# Legacy Manus OAuth. Do not use for the commercial service.
# Required only when AUTH_PROVIDER=legacy-manus.
# VITE_APP_ID=
# OAUTH_SERVER_URL=
# VITE_OAUTH_PORTAL_URL=

# Legacy Manus Forge storage. Disabled unless ENABLE_LEGACY_MANUS_STORAGE=true.
# ENABLE_LEGACY_MANUS_STORAGE=false
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=
