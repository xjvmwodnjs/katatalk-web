# KataTalk — 이 파일을 복사해 .env 로 저장하세요.
# Secret·API 키는 Git 에 절대 커밋하지 마세요.

# 서버 기동에 필요. 운영 환경에서는 충분히 긴 난수로 설정하세요.
JWT_SECRET=replace-with-a-long-random-local-secret

# --- Clerk 베타(권장) ---
AUTH_PROVIDER=clerk
VITE_AUTH_PROVIDER=clerk
# 프론트(Vite) 전용 — Clerk Dashboard 의 Publishable key
VITE_CLERK_PUBLISHABLE_KEY=
# 서버 전용 — Clerk Dashboard 의 Secret key (번들·저장소에 넣지 말 것)
CLERK_SECRET_KEY=

# --- 로컬 mock 인증 (Clerk 대신 쓸 때만) ---
# AUTH_PROVIDER=local-dev
# VITE_AUTH_PROVIDER=local-dev
LOCAL_DEV_USER_EMAIL=dev@katatalk.local
LOCAL_DEV_USER_NAME=Local Developer

# --- 선택: MySQL (있으면 사용자 행·구독 필드 동기화, 없어도 Clerk 로그인·mock 분석 가능) ---
# DATABASE_URL=mysql://user:password@localhost:3306/katatalk

PORT=3000

# --- Stripe (test mode) — Checkout + webhook 골격. Secret·Webhook secret 은 서버 전용, Git 커밋 금지 ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# 서버에서 plan → Price ID 매핑에만 사용 (클라이언트는 price id 를 보내지 않음)
STRIPE_BASIC_PRICE_ID=
STRIPE_PREMIUM_PRICE_ID=
# 프론트 표시·선택용 참고만 (결제 생성 API 는 위 서버 변수만 사용)
VITE_STRIPE_BASIC_PRICE_ID=
VITE_STRIPE_PREMIUM_PRICE_ID=
# Checkout success/cancel URL 기준 오리진 (예: dev 서버 실제 주소)
APP_BASE_URL=http://localhost:3000

# legacy Manus OAuth 등은 저장소 내 참조용입니다. 상용 Clerk 경로에서는 사용하지 않습니다.
# VITE_APP_ID= / OAUTH_SERVER_URL= / VITE_OAUTH_PORTAL_URL=
