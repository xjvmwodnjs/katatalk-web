# KataTalk — 이 파일을 복사해 .env 로 저장하세요.
# Secret·API 키는 Git 에 절대 커밋하지 마세요.
# Web / Worker / Railway 프로파일 전체: docs/env-guide.md

# 서버 기동에 필요. 운영 환경에서는 충분히 긴 난수로 설정하세요.
JWT_SECRET=replace-with-a-long-random-local-secret

# --- Clerk 베타(권장) ---
AUTH_PROVIDER=clerk
VITE_AUTH_PROVIDER=clerk
# 프론트(Vite) 전용 — Clerk Dashboard 의 Publishable key
VITE_CLERK_PUBLISHABLE_KEY=
# 서버 전용 — Clerk Dashboard 의 Secret key (번들·저장소에 넣지 말 것)
CLERK_SECRET_KEY=

# --- 로컬 mock 인증 (Clerk 대신 쓸 때만) ---
# AUTH_PROVIDER=local-dev
# VITE_AUTH_PROVIDER=local-dev
LOCAL_DEV_USER_EMAIL=dev@katatalk.local
LOCAL_DEV_USER_NAME=Local Developer

# --- 선택: MySQL (있으면 Drizzle users 동기화; 크레딧은 Supabase profiles 사용) ---
# DATABASE_URL=mysql://user:password@localhost:3306/katatalk

PORT=3000
# Railway / Render: 플랫폼이 주입하는 PORT 를 그대로 사용하세요. 대시보드에서 임의 포트로 덮어쓰지 마세요.
# Production APP_BASE_URL 은 공개 HTTPS 도메인만 (포트·localhost 아님).

# --- Production (Railway / Render 등)에서 추가로 맞출 항목 요약 ---
# NODE_ENV=production
# (위 Clerk / Supabase / Lemon / JWT_SECRET / APP_BASE_URL 필수 — 상세는 README「Railway / Render — Production 환경 변수 체크리스트」)

# --- Supabase (서비스 DB — Supabase Auth 미사용, Clerk userId = profiles.id) ---
# 브라우저에서 Supabase에 직접 붙지 않고 Express API + service role 로만 접근합니다.
SUPABASE_URL=
# 서버 전용. VITE_ 접두사 금지. Git·로그에 절대 노출 금지.
SUPABASE_SERVICE_ROLE_KEY=

# --- Toss Payments (한국) — secret 은 서버 전용, VITE_ 접두사 금지 ---
TOSS_CLIENT_KEY=
# 프론트 SDK 연동 시에만 Vite 에 노출 가능 (선택)
# VITE_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_WEBHOOK_SECRET=
TOSS_SUCCESS_URL=
TOSS_FAIL_URL=

# --- Lemon Squeezy (해외) — API 키·웹훅 시크릿은 서버 전용 ---
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_CREDIT_PACK_STARTER_VARIANT_ID=
LEMONSQUEEZY_CREDIT_PACK_STANDARD_VARIANT_ID=
LEMONSQUEEZY_CREDIT_PACK_PRO_VARIANT_ID=

APP_BASE_URL=http://localhost:3000

# Production 유료 공개 전 분석 API 차단 — 로컬/개발은 무시. 스테이징에서 mock 테스트 시에만 true.
KATATALK_ALLOW_MOCK_ANALYSIS=false

# LLM Commentary Provider v1 — 기본 disabled. 실제 연결 전까지 false/빈 값 유지.
KATATALK_LLM_COMMENTARY_ENABLED=false
# KATATALK_LLM_COMMENTARY_API_KEY=
# KATATALK_LLM_COMMENTARY_ENDPOINT=
# KATATALK_LLM_COMMENTARY_MODEL=

# mock 분석 실행 주체: inline(Express 타이머) / external(별도 worker). production 기본은 external(미설정 시).
# external + dev:worker 로 검증하려면 Supabase 004+007(claim_next_analysis_job RPC) 적용 필수.
# ANALYSIS_WORKER_MODE=external
#
# Worker 인스턴스 식별(선택). 미설정 시 hostname·pid·난수 접미사로 자동 생성된다.
# ANALYSIS_WORKER_ID=railway-worker-1
# running 잠금이 이 초를 넘기면 stale 로 간주해 다른 worker 가 재claim 할 수 있다(기본 900=15분).
# ANALYSIS_CLAIM_STALE_SECONDS=900
#
# KataGo 장시간 실행 중 `locked_at` 주기 갱신(초, 기본 60, 하한 5·상한 600).
# ANALYSIS_WORKER_HEARTBEAT_SECONDS=60
# External Worker liveness report cadence/TTL. This is separate from an analysis job lease.
# ANALYSIS_WORKER_STATUS_HEARTBEAT_SECONDS=15
# ANALYSIS_WORKER_STATUS_STALE_SECONDS=60
# Required for production external Workers. Send this value in X-Ops-Status-Token to the operations health endpoint.
# OPS_STATUS_TOKEN=
# Opt-in retention for newly queued jobs only. Empty means no automatic payload expiration.
# ANALYSIS_DATA_RETENTION_DAYS=90
# ANALYSIS_DATA_RETENTION_BATCH_SIZE=100
# 한 Worker process가 동시에 처리할 job 수(기본 1, 최대 4). 2 이상은 아래 persistent strict 안전 프로필 필수.
# ANALYSIS_WORKER_CONCURRENCY=1
#
# --- Railway 운영 프로파일(요약) — 표·주의사항 전체는 README「Railway 운영 프로파일」---
# (1) internal mock beta: Web+Worker 모두 ANALYSIS_ENGINE=mock, KATATALK_ALLOW_MOCK_ANALYSIS=true, Web 에 ANALYSIS_WORKER_MODE=external
# (2) public analysis off: ANALYSIS_ENGINE=mock, KATATALK_ALLOW_MOCK_ANALYSIS=false/미설정 → POST /api/analyze 503, worker 는 production 에서 mock claim 안 함
# (3) future GPU KataGo: Web = external+katago+mock flag off; Worker(GPU) 만 KATAGO_* + SUPABASE — Web 에 KATAGO_* 불필요. cfg 는 analysis_example.cfg 계열(GTP cfg 금지)

# 분석 엔진: mock(기본) | katago — 실 KataGo 실행은 Worker( ANALYSIS_ENGINE=katago + KATAGO_* )에서만. Web 에는 KATAGO_* 불필요.
ANALYSIS_ENGINE=mock
# Keep true in every deployed environment. false temporarily restores the pre-011
# spend-then-insert path only for an emergency rollback while investigating migration issues.
KATATALK_ATOMIC_ENQUEUE=true
# KataGo — binary/model 은 서버·worker 호스트에 설치. Git 에 커밋하지 않음.
KATAGO_BINARY_PATH=
# analysis 전용 cfg 권장: KataGo 동봉 analysis_example.cfg 등 (GTP용 gtp_example.cfg 와 혼동 금지 — numAnalysisThreads 누락 등).
KATAGO_CONFIG_PATH=
KATAGO_MODEL_PATH=
# cfg의 reportAnalysisWinratesAs 기대값(BLACK|WHITE|SIDETOMOVE). 설정 시 실제 cfg와 다르면 Worker 기동 실패.
KATAGO_REPORT_ANALYSIS_WINRATES_AS_EXPECTED=BLACK
# GPU backend smoke opt-in. true면 cuda/opencl/tensorrt 감지 또는 검사 실패 시 worker startup 실패.
KATAGO_REQUIRE_GPU_BACKEND=false
# version | analysis_smoke | version_then_smoke. 로컬 GPU 검증에는 version_then_smoke 권장.
KATAGO_BACKEND_CHECK_MODE=version
# backend analysis smoke query에 사용하는 저비용 visits.
KATAGO_BACKEND_CHECK_SMOKE_VISITS=10
KATAGO_BACKEND_CHECK_TIMEOUT_MS=10000
# primary visits: 기본 200, 무효값→200, strict integer, clamp 1..5000
KATAGO_MAX_VISITS=200
# primary timeout(ms): 기본 120000, 무효값→120000, strict integer, clamp 30000..900000
KATAGO_ANALYSIS_TIMEOUT_MS=120000
# 장기 실행 Worker에서 root KataGo process/model 재사용. 기본 false.
KATAGO_PERSISTENT_ROOT_ENABLED=false
# true면 persistent root 실패 시 one-shot spawn으로 우회하지 않고 작업 실패.
KATAGO_PERSISTENT_ROOT_STRICT=false
# 공유 process 유휴 종료(ms): 기본 60000, clamp 1000..900000
KATAGO_PERSISTENT_ROOT_IDLE_CLOSE_MS=60000
# root와 같은 process/model로 multi-turn query도 실행. persistent root가 켜져 있어야 유효.
KATAGO_PERSISTENT_MULTI_TURN_ENABLED=false
# true면 persistent multi-turn 실패 query를 별도 process로 재시도하지 않음.
KATAGO_PERSISTENT_MULTI_TURN_STRICT=false
# 한 job이 공유 KataGo process에 동시에 보낼 multi-turn query 수(기본 6, clamp 1..16).
# ANALYSIS_WORKER_CONCURRENCY=2..4 운영 시 공정성과 timeout 보호를 위해 반드시 1.
KATAGO_PERSISTENT_MULTI_TURN_PER_JOB_CONCURRENCY=6
# analysisPlan 후보별 추가 분석 — 기본 6개까지, 0이면 생략, max 100.
# 배치 stdin(기본) / KATAGO_MULTI_TURN_BATCH=0 이면 수순마다 별도 프로세스(비효율·README 참고).
KATAGO_MULTI_TURN_MAX=6
# multi-turn visits: 미설정 시 KATAGO_MAX_VISITS, strict integer, clamp 1..5000
# KATAGO_MULTI_TURN_MAX_VISITS=
# multi-turn timeout(ms): 미설정 시 KATAGO_ANALYSIS_TIMEOUT_MS, strict integer, clamp 30000..900000
# KATAGO_MULTI_TURN_QUERY_TIMEOUT_MS=
# multi-turn batch timeout(ms): 미설정 시 자동 산출, strict integer, clamp 30000..900000
# KATAGO_MULTI_TURN_BATCH_TIMEOUT_MS=
# KATAGO_MULTI_TURN_BATCH=0
# 순차 모드에서만: id 없는 stdout 일 때 pickPrimary 폴백(위험·디버그용). 미설정/ false 권장.
# KATAGO_MULTI_TURN_ALLOW_IDLESS_SEQUENTIAL_FALLBACK=false
# Deep Search Execution v1 — 기본 OFF. true 일 때만 worker 가 deepSearchPlan 후보에 대해 추가 KataGo(높은 visits) 순차 실행. Railway CPU 에서 실수로 켜지지 않게 할 것(README「Deep Search Execution v1」).
KATAGO_DEEP_SEARCH_ENABLED=false
KATAGO_DEEP_SEARCH_MAX_CANDIDATES=2
KATAGO_DEEP_SEARCH_VISITS=800
KATAGO_DEEP_SEARCH_TIMEOUT_MS=180000
# v1 은 순차만. 배치 stdin 모드는 미구현(TODO).
# KATAGO_DEEP_SEARCH_BATCH=0
#
# Full-game winrate timeline v1 — Worker 전용(기본 OFF). Railway CPU 에서 ON 비권장.
# KATAGO_WINRATE_TIMELINE_ENABLED=false
# KATAGO_WINRATE_TIMELINE_MAX_VISITS=50
# KATAGO_WINRATE_TIMELINE_REPORT_EVERY_SECONDS=0.5
# timeline visits: 기본 50, 무효값→50, clamp 1..2000 (docs/env-guide.md)
# KATAGO_WINRATE_TIMELINE_MAX_TURNS=300
# KATAGO_WINRATE_TIMELINE_TIMEOUT_MS=600000
# KATAGO_WINRATE_TIMELINE_ANALYSIS_PV_LEN=1
# KATAGO_WINRATE_TIMELINE_INCLUDE_FINAL=true
# KATAGO_WINRATE_TIMELINE_LOCAL_PROGRESS=false
#
# VITE_APP_ID= / OAUTH_SERVER_URL= / VITE_OAUTH_PORTAL_URL=
