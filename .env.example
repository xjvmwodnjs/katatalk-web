# KataTalk — 이 파일을 복사해 .env 로 저장하세요.
# Secret·API 키는 Git 에 절대 커밋하지 마세요.

# 서버 기동에 필요. 운영 환경에서는 충분히 긴 난수로 설정하세요.
JWT_SECRET=replace-with-a-long-random-local-secret

# --- Clerk 베타(권장) ---
AUTH_PROVIDER=clerk
VITE_AUTH_PROVIDER=clerk
# 프론트(Vite) 전용 — Clerk Dashboard 의 Publishable key
VITE_CLERK_PUBLISHABLE_KEY=
# 서버 전용 — Clerk Dashboard 의 Secret key (번들·저장소에 넣지 말 것)
CLERK_SECRET_KEY=

# --- 로컬 mock 인증 (Clerk 대신 쓸 때만) ---
# AUTH_PROVIDER=local-dev
# VITE_AUTH_PROVIDER=local-dev
LOCAL_DEV_USER_EMAIL=dev@katatalk.local
LOCAL_DEV_USER_NAME=Local Developer

# --- 선택: MySQL (있으면 Drizzle users 동기화; 크레딧은 Supabase profiles 사용) ---
# DATABASE_URL=mysql://user:password@localhost:3306/katatalk

PORT=3000
# Railway / Render: 플랫폼이 주입하는 PORT 를 그대로 사용하세요. 대시보드에서 임의 포트로 덮어쓰지 마세요.
# Production APP_BASE_URL 은 공개 HTTPS 도메인만 (포트·localhost 아님).

# --- Production (Railway / Render 등)에서 추가로 맞출 항목 요약 ---
# NODE_ENV=production
# (위 Clerk / Supabase / Lemon / JWT_SECRET / APP_BASE_URL 필수 — 상세는 README「Railway / Render — Production 환경 변수 체크리스트」)

# --- Supabase (서비스 DB — Supabase Auth 미사용, Clerk userId = profiles.id) ---
# 브라우저에서 Supabase에 직접 붙지 않고 Express API + service role 로만 접근합니다.
SUPABASE_URL=
# 서버 전용. VITE_ 접두사 금지. Git·로그에 절대 노출 금지.
SUPABASE_SERVICE_ROLE_KEY=

# --- Toss Payments (한국) — secret 은 서버 전용, VITE_ 접두사 금지 ---
TOSS_CLIENT_KEY=
# 프론트 SDK 연동 시에만 Vite 에 노출 가능 (선택)
# VITE_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_WEBHOOK_SECRET=
TOSS_SUCCESS_URL=
TOSS_FAIL_URL=

# --- Lemon Squeezy (해외) — API 키·웹훅 시크릿은 서버 전용 ---
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_CREDIT_PACK_STARTER_VARIANT_ID=
LEMONSQUEEZY_CREDIT_PACK_STANDARD_VARIANT_ID=
LEMONSQUEEZY_CREDIT_PACK_PRO_VARIANT_ID=

APP_BASE_URL=http://localhost:3000

# Production 유료 공개 전 분석 API 차단 — 로컬/개발은 무시. 스테이징에서 mock 테스트 시에만 true.
KATATALK_ALLOW_MOCK_ANALYSIS=false

# legacy Manus OAuth 등은 저장소 내 참조용입니다. 상용 Clerk 경로에서는 사용하지 않습니다.
# VITE_APP_ID= / OAUTH_SERVER_URL= / VITE_OAUTH_PORTAL_URL=
