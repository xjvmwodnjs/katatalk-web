{
  "name": "baduk-ai-report",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/run-server.mjs development tsx watch server/_core/index.ts",
    "dev:worker": "node scripts/run-server.mjs development tsx watch server/worker/analysisWorker.ts",
    "build": "vite build && tsx scripts/verify-client-build-artifact.ts && esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist && esbuild server/worker/analysisWorker.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/worker/analysisWorker.js",
    "start": "node scripts/run-server.mjs production node dist/index.js",
    "worker:analysis": "node scripts/run-server.mjs production node dist/worker/analysisWorker.js",
    "worker:preflight": "tsx scripts/worker-preflight.ts",
    "check": "tsc --noEmit",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "ci:secrets": "tsx scripts/ci-secret-scan.ts",
    "client:artifact:verify": "tsx scripts/verify-client-build-artifact.ts",
    "client:clerk-key-fingerprint": "tsx scripts/print-clerk-key-fingerprint.ts",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:ci": "vitest run --maxWorkers=1 --fileParallelism=false",
    "katago:smoke": "tsx scripts/katago-smoke.ts",
    "katago:corpus-validate": "tsx scripts/katago-corpus-validate.ts",
    "katago:product-smoke": "tsx scripts/katago-product-smoke.ts",
    "katago:product-suite": "tsx scripts/katago-product-suite.ts",
    "katago:persistent-benchmark": "tsx scripts/katago-persistent-benchmark.ts",
    "katago:concurrency-benchmark": "tsx scripts/katago-concurrency-benchmark.ts",
    "deploy:smoke": "tsx scripts/deploy-smoke.ts",
    "credits:audit": "tsx scripts/credit-ledger-audit.ts",
    "credits:reconcile-finalization": "tsx scripts/analysis-finalization-reconcile.ts",
    "data:retention": "tsx scripts/analysis-data-retention.ts",
    "db:migrate:supabase": "node scripts/db/migrate.mjs",
    "db:evidence:staging": "node scripts/db/collect-staging-evidence.mjs",
    "test:db:migrations": "node scripts/db/ci-gate.mjs",
    "db:legacy-mysql": "drizzle-kit generate && drizzle-kit migrate",
    "db:push": "drizzle-kit generate && drizzle-kit migrate"
  },
  "dependencies": {
    "@clerk/backend": "^3.4.7",
    "@clerk/clerk-react": "5.61.6",
    "@clerk/localizations": "^4.6.2",
    "@clerk/themes": "^2.4.57",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/supabase-js": "^2.105.4",
    "@tanstack/react-query": "^5.90.2",
    "@trpc/client": "^11.6.0",
    "@trpc/react-query": "^11.6.0",
    "@trpc/server": "^11.6.0",
    "axios": "^1.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie": "^1.0.2",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.45.2",
    "express": "^4.22.2",
    "express-rate-limit": "^8.5.1",
    "jose": "6.1.0",
    "lucide-react": "^0.453.0",
    "multer": "^2.2.0",
    "mysql2": "^3.15.0",
    "nanoid": "^5.1.16",
    "next-themes": "^0.4.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "sonner": "^2.0.7",
    "superjson": "^1.13.3",
    "tailwind-merge": "^3.3.1",
    "wouter": "^3.3.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.1.3",
    "@types/express": "4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.4",
    "esbuild": "^0.25.0",
    "pnpm": "^10.15.1",
    "postcss": "^8.4.47",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.19.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "^7.1.7",
    "vitest": "^2.1.4"
  },
  "packageManager": "pnpm@10.18.1+sha512.77a884a165cbba2d8d1c19e3b4880eee6d2fcabd0d879121e282196b80042351d5eb3ca0935fa599da1dc51265cc68816ad2bddd2a2de5ea9fdf92adbec7cd34"
}
